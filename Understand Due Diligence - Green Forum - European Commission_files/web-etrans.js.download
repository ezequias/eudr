var k={etrans:{bg:{automaticallyTranslated:"Автоматично преведена страница",machineTranslation:"Тази страница е преведена с машинен превод.<br />Помогнете ни да подобрим услугата, като {link}отговорите на два въпроса{/link}.",translatePage:"Превод на тази страница",translate:"Превод",close:"Затваряне",closeAriaLabel:"Натиснете ESC, за да затворите този прозорец",closeTitle:"Затваряне на прозореца",attention:"Отказ от отговорност",disclaimer:"Това е машинен превод, извършен чрез услугата на Европейската комисия eTranslation, и има за цел да ви помогне да разберете съдържанието на тази страница.",disclaimerLink:"Моля, прочетете условията за ползване.",selectLanguage:"Изберете език",accept:"Приемане и продължаване",translationInProgress:"В процес на превод. Моля, изчакайте.",translationFailed:"Неуспешен превод.",failedETranslation:"В момента услугата eTranslation не е достъпна. Моля, опитайте отново по-късно.",failedWebtools:"Съжаляваме, тази страница не може да бъде преведена поради технически проблеми.",retry:"Опитай отново",readDisclaimer:"Прочетете декларацията за отказ от отговорност",returnToLanguage:"Назад към оригиналната езикова версия ({original_language})",translationAborted:"Съдържанието на страницата се е променило. Моля, {link}рестартирайте превода{/link}.",labelCancelTranslation:"Отмяна на превода"},cs:{automaticallyTranslated:"Automaticky přeložená stránka",machineTranslation:"Tato stránka byla přeložena pomocí strojového překladu.<br />Chcete nám pomoci zlepšit naši službu? {link}Zodpovězte prosím dvě otázky{/link}.",translatePage:"Přeložit tuto stránku",translate:"Přeložit",close:"Zavřít",closeAriaLabel:"Chcete-li toto okno zavřít, stiskněte ESC.",closeTitle:"Zavřít okno.",attention:"Upozornění",disclaimer:"Jedná se o strojový překlad vytvořený online službou eTranslation, kterou Evropská komise poskytuje, aby vám usnadnila porozumění obsahu této stránky.",disclaimerLink:"Přečtěte si prosím podmínky použití.",selectLanguage:"Zvolte jazyk",accept:"Potvrzuji a chci pokračovat",translationInProgress:"Překlad právě probíhá. Čekejte prosím...",translationFailed:"Překlad se nepodařilo vytvořit.",failedETranslation:"Služba eTranslation není v tuto chvíli k dispozici. Zkuste to prosím znovu později.",failedWebtools:"Tuto stránku nelze bohužel z technických důvodu přeložit.",retry:"Zkusit znovu",readDisclaimer:"přečíst upozornění",returnToLanguage:"Jít zpět na jazyk originálu ({original_language})",translationAborted:"Obsah stránky se změnil. Prosím {link}restartujte překlad {/link}.",labelCancelTranslation:"Zrušit překlad"},da:{automaticallyTranslated:"Maskinoversat side",machineTranslation:"Denne side er oversat ved hjælp af maskinoversættelse.<br />Hjælp os med at forbedre oversættelsestjenesten ved {link}at besvare to spørgsmål{/link}.",translatePage:"Oversæt denne side",translate:"Oversæt",close:"Luk",closeAriaLabel:"Tryk på Esc for at lukke dette vindue",closeTitle:"Luk vinduet",attention:"Ansvarsfraskrivelse",disclaimer:"Dette er en maskinoversættelse foretaget af Europa-Kommissionens eTranslation-tjeneste for at hjælpe dig med at forstå denne side.",disclaimerLink:"Læs anvendelsesbetingelserne.",selectLanguage:"Vælg sprog nedenfor",accept:"Acceptér og fortsæt",translationInProgress:"Teksten er ved at blive oversat. Vent et øjeblik.",translationFailed:"Oversættelse mislykkedes.",failedETranslation:"Maskinoversættelse med eTranslation er ikke tilgængelig på nuværende tidspunkt. Prøv igen senere.",failedWebtools:"Vi beklager, at denne side ikke kan oversættes på grund af tekniske problemer.",retry:"Prøv igen",readDisclaimer:"læs ansvarsfraskrivelsen",returnToLanguage:"Gå tilbage til originalsproget ({original_language})",translationAborted:"Sidens indhold er ændret. {link}Oversæt siden igen{/link}.",labelCancelTranslation:"Annullér oversættelsen"},de:{automaticallyTranslated:"Automatisch übersetzte Seite",machineTranslation:"Diese Seite wurde maschinell übersetzt.<br />Helfen Sie uns, unser Angebot zu verbessern! {link}Beantworten Sie zwei Fragen{/link}",translatePage:"Diese Seite übersetzen",translate:"Übersetzen",close:"Schließen",closeAriaLabel:"Drücken Sie ESC, um das Fenster zu schließen",closeTitle:"Fenster schließen",attention:"Haftungsausschluss",disclaimer:"Dies ist eine maschinelle Übersetzung. Sie wird vom Dienst „eTranslation“ der Europäischen Kommission bereitgestellt, um Ihnen das Verständnis dieser Seite zu erleichtern.",disclaimerLink:"Bitte lesen Sie die Nutzungsbedingungen.",selectLanguage:"Sprache auswählen",accept:"Akzeptieren und fortfahren",translationInProgress:"Seite wird übersetzt. Bitte warten.",translationFailed:"Übersetzung fehlgeschlagen.",failedETranslation:"eTranslation ist momentan nicht verfügbar. Bitte versuchen Sie es später erneut.",failedWebtools:"Leider kann diese Seite aufgrund technischer Probleme nicht übersetzt werden.",retry:"Noch einmal versuchen",readDisclaimer:"Haftungsausschluss lesen",returnToLanguage:"Zurück zur Ausgangssprache ({original_language})",translationAborted:"Der Inhalt der Seite hat sich geändert. Bitte {link}fordern Sie eine neue Übersetzung an{/link}.",labelCancelTranslation:"Übersetzung abbrechen"},el:{automaticallyTranslated:"Σελίδα από αυτόματη μετάφραση",machineTranslation:"Αυτή η σελίδα μεταφράστηκε με τη χρήση αυτόματης μετάφρασης.<br />Για να μας βοηθήσετε να βελτιώσουμε τις υπηρεσίες μας, {link}απαντήστε σε δύο ερωτήσεις{/link}.",translatePage:"Να μεταφραστεί αυτή η σελίδα",translate:"Μετάφραση",close:"Κλείσιμο",closeAriaLabel:"Πατήστε ESC για να κλείσετε αυτό το παράθυρο",closeTitle:"Κλείσιμο παραθύρου",attention:"Δήλωση αποποίησης ευθύνης",disclaimer:"Η σελίδα αυτή θα μεταφραστεί αυτόματα από την υπηρεσία eTranslation της Ευρωπαϊκής Επιτροπής για να αποκτήσετε μία γενική εικόνα του περιεχομένου της.",disclaimerLink:"Διαβάστε τους όρους χρήσης.",selectLanguage:"Επιλέξτε γλώσσα παρακάτω",accept:"Αποδοχή και συνέχεια",translationInProgress:"Η μετάφραση βρίσκεται σε εξέλιξη. Περιμένετε.",translationFailed:"Η μετάφραση απέτυχε.",failedETranslation:"Η υπηρεσία eTranslation αυτή τη στιγμή δεν είναι διαθέσιμη. Παρακαλούμε δοκιμάστε ξανά αργότερα.",failedWebtools:"Λυπούμαστε, η σελίδα αυτή δεν μπορεί να μεταφραστεί λόγω τεχνικών δυσκολιών.",retry:"Δοκιμάστε ξανά",readDisclaimer:"διαβάστε τη δήλωση αποποίησης ευθύνης",returnToLanguage:"Επιστροφή στην αρχική γλώσσα ({original_language})",translationAborted:"Το περιεχόμενο της σελίδας έχει αλλάξει. {link}Ξαναρχίστε τη διαδικασία μετάφρασης{/link}.",labelCancelTranslation:"Ακύρωση μετάφρασης"},en:{automaticallyTranslated:"Automatically translated page",machineTranslation:"This page was translated using machine translation.<br />Help us improve our service by {link}answering two questions{/link}",translatePage:"Translate this page",translate:"Translate",close:"Close",closeAriaLabel:"Press ESC to close this window",closeTitle:"Close this window",attention:"Disclaimer",disclaimer:"This is a machine translation provided by the European Commission’s eTranslation service to help you understand this page.",disclaimerLink:"Please read the conditions of use.",selectLanguage:"Select language below",accept:"Accept and continue",translationInProgress:"Translation is ongoing. Please wait.",translationFailed:"The translation failed.",failedETranslation:"eTranslation is unavailable at the moment. Please try again later.",failedWebtools:"Sorry, this page cannot be translated due to technical issues.",retry:"Try again",readDisclaimer:"read the disclaimer",returnToLanguage:"Go back to the original language ({original_language})",translationAborted:"The content of the page has changed. Please {link}restart the translation{/link}.",labelCancelTranslation:"Cancel translation"},es:{automaticallyTranslated:"Página traducida automáticamente",machineTranslation:"Esta página se ha traducido con un programa de traducción automática.<br />Ayúdenos a mejorar el servicio {link}respondiendo a dos preguntas{/link}",translatePage:"Traducir esta página",translate:"Traducir",close:"Cerrar",closeAriaLabel:"Pulse Esc para cerrar esta ventana",closeTitle:"Cerrar esta ventana",attention:"Aviso de exención de responsabilidad",disclaimer:"Esto es una traducción automática generada por el servicio eTranslation de la Comisión Europea para ayudarle a entender esta página.",disclaimerLink:"Lea las condiciones de uso.",selectLanguage:"Seleccionar la lengua",accept:"Aceptar y continuar",translationInProgress:"La traducción está en curso. Espere, por favor.",translationFailed:"No se ha podido efectuar la traducción.",failedETranslation:"eTranslation no está disponible en este momento. Inténtelo de nuevo más tarde.",failedWebtools:"Lo sentimos, esta página no puede traducirse debido a problemas técnicos.",retry:"Vuelva a intentarlo",readDisclaimer:"leer el aviso de exención de responsabilidad",returnToLanguage:"Volver a la lengua original ({original_language})",translationAborted:"El contenido de la página ha cambiado. Por favor, {link}reinicie la traducción{/link}.",labelCancelTranslation:"Cancelar la traducción"},et:{automaticallyTranslated:"Masintõlgitud veebileht",machineTranslation:"See lehekülg tõlgiti masintõlke abil.<br />Aidake meil seda teenust täiustada, {link}vastates kahele küsimusele{/link}.",translatePage:"Tõlgi see veebileht",translate:"Tõlgi",close:"Sulge",closeAriaLabel:"Akna sulgemiseks vajuta ESC",closeTitle:"Sulge aken",attention:"Hoiatus",disclaimer:"See on masintõlge, mida pakub Euroopa Komisjoni masintõlkemootor eTranslation, et aidata teil selle veebilehe sisust aru saada.",disclaimerLink:"Palun lugege kasutustingimusi.",selectLanguage:"Vali keel",accept:"Nõustu ja jätka",translationInProgress:"Tõlkimine on pooleli. Palun oodake.",translationFailed:"Tõlkimine ebaõnnestus.",failedETranslation:"Masintõlkevahend eTranslation ei ole hetkel kättesaadav. Palun proovige hiljem uuesti.",failedWebtools:"Vabandame, seda lehekülge ei ole tehniliste probleemide tõttu võimalik tõlkida.",retry:"Proovi uuesti",readDisclaimer:"loe vastutuse välistamise klauslit",returnToLanguage:"Tagasi algkeele juurde ({original_language})",translationAborted:"Lehekülje sisu on muutunud. Palun {link}alustage tõlkimist otsast peale{/link}.",labelCancelTranslation:"Tühista tõlkimine"},fi:{automaticallyTranslated:"Tämän sivun teksti on konekäännös",machineTranslation:"Tämän sivun teksti on konekäännös.<br />Auta meitä parantamaan palveluamme ja {link}vastaa kahteen kysymykseen{/link}.",translatePage:"Käännä tämä sivu",translate:"Käännä",close:"Sulje",closeAriaLabel:"Sulje tämä ikkuna painamalla ESC-näppäintä",closeTitle:"Sulje tämä ikkuna",attention:"Vastuuvapauslauseke",disclaimer:"Tämä toiminto tuottaa konekäännöksen, joka tehdään Euroopan komission eTranslation-ohjelmalla. Sen tarkoituksena on antaa lukijalle ylimalkainen käsitys sivun sisällöstä.",disclaimerLink:"Lue käyttöehdot",selectLanguage:"Valitse kieli",accept:"Hyväksy ja jatka",translationInProgress:"Konekäännös tekeillä – odota hetki.",translationFailed:"Konekäännös epäonnistui.",failedETranslation:"eTranslation ei ole juuri nyt käytettävissä. Yritä myöhemmin uudelleen.",failedWebtools:"Tämän sivun tekstiä ei voi kääntää teknisistä syistä.",retry:"Yritä uudestaan",readDisclaimer:"Lue vastuuvapauslauseke",returnToLanguage:"Palaa alkuperäiseen kieliversioon ({original_language})",translationAborted:"Sivun sisältö on muuttunut. {link}Käännä sivu uudelleen{/link}.",labelCancelTranslation:"Peruuta käännöspyyntö"},fr:{automaticallyTranslated:"Page traduite automatiquement",machineTranslation:"Cette page a été traduite par traduction automatique.<br />Aidez-nous à améliorer notre service en {link}répondant à deux questions{/link}.",translatePage:"Traduire cette page",translate:"Traduire",close:"Fermer",closeAriaLabel:"Appuyez sur ESC pour fermer cette fenêtre",closeTitle:"Fermer cette fenêtre",attention:"Clause de non-responsabilité",disclaimer:"La page sera traduite via eTranslation, le service de traduction automatique de la Commission européenne, pour vous donner une idée générale de son contenu.",disclaimerLink:"Lire les conditions d’utilisation.",selectLanguage:"Sélectionnez la langue ci-dessous",accept:"Accepter et continuer",translationInProgress:"Traduction en cours. Veuillez patienter.",translationFailed:"La traduction a échoué.",failedETranslation:"eTranslation n’est pas disponible actuellement. Veuillez réessayer plus tard.",failedWebtools:"Désolé, cette page ne peut pas être traduite en raison de problèmes techniques.",retry:"Réessayer",readDisclaimer:"lire la clause de non-responsabilité",returnToLanguage:"Revenir à la langue d’origine ({original_language})",translationAborted:"Le contenu de la page a changé. Veuillez {link}relancer la traduction{/link}.",labelCancelTranslation:"Annuler la traduction"},ga:{automaticallyTranslated:"Leathanach a aistríodh go huathoibríoch",machineTranslation:"Is le córas meaisínaistriúcháin a foilsíodh an leathanach seo.<br />Cabhraigh linn feabhas a chur ar ár seirbhís trí {link}dhá cheist a fhreagairt{/link}.",translatePage:"Aistrigh an leathanach seo",translate:"Aistrigh",close:"Dún",closeAriaLabel:"Brúigh ESC chun an fhuinneog seo a dhúnadh",closeTitle:"Dún an fhuinneog seo",attention:"Séanadh",disclaimer:"Is aistriúchán uathoibríoch é seo atá curtha ar fáil ag seirbhís uathaistriúcháin an Choimisiúin Eorpaigh, eTranslation, chun cuidiú leat an leathanach seo a thuiscint.",disclaimerLink:"Léigh na coinníollacha úsáide, le do thoil.",selectLanguage:"Roghnaigh an teanga thíos",accept:"Glac leis agus lean ar aghaidh",translationInProgress:"Tá an t-aistriúchán á dhéanamh. Fan go fóill.",translationFailed:"Theip ar an aistriúchán.",failedETranslation:"Níl eTranslation ar fáil faoi láthair. Bain triail as arís ar ball.",failedWebtools:"Ár leithscéal, ní féidir an leathanach seo a aistriú mar gheall ar fhadhbanna teicniúla.",retry:"Bain triail as arís",readDisclaimer:"Léigh an séanadh",returnToLanguage:"Téigh ar ais go dtí an leagan sa bhunteanga ({original_language})",translationAborted:"Athraíodh ábhar an leathanaigh. {link}Atosaigh an t-aistriúchán{/link}, le do thoil.",labelCancelTranslation:"Cealaigh an t-aistriúchán"},hr:{automaticallyTranslated:"Strojno prevedena stranica",machineTranslation:"Ova stranica je strojno prevedena.<br />Pomozite nam da poboljšamo ovu uslugu {link}tako što ćete odgovoriti na dva pitanja{/link}.",translatePage:"Prevedi ovu stranicu",translate:"Prevedi",close:"Zatvori",closeAriaLabel:"Pritisnuti ESC za zatvaranje prozora",closeTitle:"Zatvaranje prozora",attention:"Izjava o ograničenju odgovornosti",disclaimer:"Kako biste bolje razumjeli sadržaj na ovoj stranici, prikazat će Vam se strojni prijevod generiran uslugom eTranslation Europske komisije.",disclaimerLink:"Pročitajte uvjete korištenja.",selectLanguage:"Odaberite jezik",accept:"Prihvati i nastavi",translationInProgress:"Prevođenje u tijeku, molimo da pričekate.",translationFailed:"Pogreška u prevođenju.",failedETranslation:"eTranslation trenutačno nije dostupan. Pokušajte kasnije.",failedWebtools:"Nažalost, ovu stranicu nije moguće prevesti zbog tehničkih problema.",retry:"Ponovno pokušaj prevesti",readDisclaimer:"Izjava o ograničenju odgovornosti",returnToLanguage:"Prebaci na izvorni jezik ({original_language})",translationAborted:"Promijenio se sadržaj stranice. Ponovno {link}zatražite prijevod{/link}.",labelCancelTranslation:"Odustani od prijevoda"},hu:{automaticallyTranslated:"Gépi fordítással készült oldal",machineTranslation:"Ennek az oldalnak a fordítása gépi fordítással készült.<br />Kérjük, segítsen javítani szolgáltatásunk színvonalát azzal, hogy {link}válaszol két kérdésre{/link}.",translatePage:"Az oldal lefordítása",translate:"Fordítás",close:"Bezárás",closeAriaLabel:"Az ablak bezárásához nyomja meg az ESC gombot",closeTitle:"Ablak bezárása",attention:"Felelősségkizáró nyilatkozat",disclaimer:"Ezen a felületen Ön gépi fordítást tud kezdeményezni, mely az Európai Bizottság eTranslation fordítóprogramjával fog elkészülni. A gépi fordítás célja, hogy általános tájékoztatást nyújtson a kért nyelven a megjelenített oldal tartalmáról.",disclaimerLink:"Kérjük, olvassa el a használati feltételeket.",selectLanguage:"Válasszon az alábbi nyelvek közül",accept:"Elfogadás és folytatás",translationInProgress:"A fordítás folyamatban van. Kérjük, várjon...",translationFailed:"Nem sikerült elkészíteni a fordítást.",failedETranslation:"Az eTranslation eszköz jelenleg nem érhető el. Kérjük, próbálkozzon később.",failedWebtools:"Nagyon sajnáljuk, de ez az oldal műszaki problémák miatt nem fordítható le.",retry:"Új próbálkozás",readDisclaimer:"felelősségkizáró nyilatkozatot elolvasása",returnToLanguage:"Vissza az eredeti, {original_language} nyelvű változathoz",translationAborted:"Az oldal tartalma megváltozott. Kérjük, {link}indítsa el újra a fordítást{/link}.",labelCancelTranslation:"A fordítási kérés visszavonása"},it:{automaticallyTranslated:"Pagina tradotta automaticamente",machineTranslation:"Questa pagina è stata tradotta grazie alla traduzione automatica.<br />Aiutaci a migliorare il nostro servizio {link}rispondendo a due domande{/link}.",translatePage:"Traduci questa pagina",translate:"Traduci",close:"Chiudi",closeAriaLabel:"Premere ESC per chiudere la finestra",closeTitle:"Chiudi la finestra",attention:"Clausola di esclusione della responsabilità",disclaimer:"Questa pagina sarà tradotta automaticamente dal servizio eTranslation della Commissione europea per facilitarne la comprensione.",disclaimerLink:"Leggi le condizioni d’uso.",selectLanguage:"Seleziona la lingua qui sotto",accept:"Accetta e continua",translationInProgress:"Traduzione in corso. Attendere qualche istante.",translationFailed:"Ci sono stati problemi con la traduzione.",failedETranslation:"eTranslation non è disponibile al momento. Riprovare più tardi.",failedWebtools:"Spiacenti, la pagina non può essere tradotta a causa di problemi tecnici.",retry:"Riprova",readDisclaimer:"leggi la clausola di esclusione della responsabilità",returnToLanguage:"Ritorna alla lingua originale ({original_language})",translationAborted:"Il contenuto della pagina è cambiato. Si prega di {link}ricominciare la traduzione{/link}.",labelCancelTranslation:"Annulla traduzione"},lt:{automaticallyTranslated:"Automatiškai išverstas puslapis",machineTranslation:"Šis puslapis buvo išverstas naudojant mašininį vertimą.<br />Padėkite mums tobulinti savo paslaugas {link}atsakydami į du klausimus{/link}.",translatePage:"Išversti šį puslapį",translate:"Versti",close:"Uždaryti",closeAriaLabel:"Kad uždarytumėte šį langą, spauskite grįžimo klavišą „Esc“",closeTitle:"Uždaryti šį langą",attention:"Atsakomybės ribojimo pareiškimas",disclaimer:"Tai mašininis vertimas, sugeneruotas Europos Komisijos vertykle „eTranslation“ , kad galėtumėte suprasti šio puslapio turinį.",disclaimerLink:"Susipažinkite su naudojimo sąlygomis.",selectLanguage:"Pasirinkti kalbą",accept:"Sutikti ir tęsti",translationInProgress:"Verčiama. Lukterėkite.",translationFailed:"Vertimas nepavyko.",failedETranslation:"Šiuo metu „eTranslation“ neveikia. Bandykite vėliau.",failedWebtools:"Atsiprašome, šio puslapio negalima išversti dėl techninių problemų.",retry:"Bandykite dar kartą",readDisclaimer:"Skaityti atsakomybės ribojimo pareiškimą",returnToLanguage:"Grįžti į originalo kalbą ({original_language})",translationAborted:"Puslapio turinys pasikeitė. {link}Vertimą pradėkite iš naujo{/link}.",labelCancelTranslation:"Atšaukti vertimą"},lv:{automaticallyTranslated:"Automātiski tulkota lapa",machineTranslation:"Šī lapa ir pārtulkota ar mašīntulkošanas palīdzību.<br />Palīdziet mums uzlabot pakalpojumu,{link}atbildot uz diviem jautājumiem{/link}.",translatePage:"Pārtulkot šo lapu",translate:"Tulkot",close:"Aizvērt",closeAriaLabel:"Nospiediet taustiņu “Esc”, lai aizvērtu šo logu",closeTitle:"Aizvērt šo logu",attention:"Atruna",disclaimer:'Šis ir mašīntulkojums, kuru nodrošinājis Eiropas Komisijas mašīntulkošanas pakalpojums “eTranslation",  lai jums palīdzētu aptuveni saprast šīs lapas saturu.',disclaimerLink:"Lūdzu, izlasiet lietošanas noteikumus!",selectLanguage:"Atlasiet valodu",accept:"Apstiprināt un turpināt",translationInProgress:"Notiek tulkošana. Lūdzu, uzgaidiet!",translationFailed:"Neizdevās pārtulkot.",failedETranslation:"Pakalpojums “eTranslation” pašlaik nav pieejams. Mēģiniet vēlreiz vēlāk!",failedWebtools:"Diemžēl šo lapu nevar tulkot tehnisku iemeslu dēļ.",retry:"Mēģināt vēlreiz",readDisclaimer:"Izlasīt atrunu",returnToLanguage:"Pāriet atpakaļ pie versijas oriģinālvalodā ({original_language})",translationAborted:"Lapas saturs ir mainījies. {link}Atsākt tulkošanu{/link}.",labelCancelTranslation:"Atcelt tulkošanu"},mt:{automaticallyTranslated:"Paġna awtomatikament tradotta",machineTranslation:"Din il-paġna ġiet tradotta permezz tat-traduzzjoni awtomatika.<br />Għinna ntejbu s-servizz tagħna billi {link}twieġeb żewġ mistoqsijiet{/link}.",translatePage:"Ittraduċi din il-paġna",translate:"Ittraduċi",close:"Agħlaq",closeAriaLabel:"Agħfas l-ESC biex tagħlaq din il-window",closeTitle:"Agħlaq din il-window",attention:"Dikjarazzjoni ta’ ċaħda ta’ responsabbiltà",disclaimer:"Din hija traduzzjoni awtomatika pprovduta mis-servizz tal-eTranslation tal-Kummissjoni Ewropea biex tgħinek tifhem din il-paġna.",disclaimerLink:"Jekk jogħġbok aqra l-kundizzjonijiet tal-użu.",selectLanguage:"Agħżel lingwa hawn taħt",accept:"Aċċetta u kompli",translationInProgress:"It-traduzzjoni qiegħda ssir. Jekk jogħġbok stenna.",translationFailed:"It-traduzzjoni ma saritx.",failedETranslation:"L-eTranslation mhix disponibbli bħalissa. Jekk jogħġbok erġa’ pprova aktar tard.",failedWebtools:"Jiddispjaċina, din il-paġna ma tistax tiġi tradotta minħabba problemi tekniċi.",retry:"Erġa’ pprova",readDisclaimer:"aqra d-dikjarazzjoni ta’ ċaħda ta’ responsabbiltà",returnToLanguage:"Mur lura għal-lingwa oriġinali ({original_language})",translationAborted:"Il-kontenut tal-paġna nbidel. Jekk jogħġbok {link}erġa’ ibda t-traduzzjoni{/link}.",labelCancelTranslation:"Ikkanċella t-traduzzjoni"},nl:{automaticallyTranslated:"Automatisch vertaalde pagina",machineTranslation:"Deze pagina is vertaald met behulp van machinevertaling.<br />{link}Beantwoord twee vragen{/link} zodat wij u beter van dienst kunnen zijn.",translatePage:"Deze pagina vertalen",translate:"Vertalen",close:"Sluiten",closeAriaLabel:"Druk op ESC om dit venster te sluiten",closeTitle:"Dit venster sluiten",attention:"Disclaimer",disclaimer:"Deze tekst is automatisch vertaald door eTranslation, de vertaalmachine van de Europese Commissie, om u een idee te geven van de inhoud.",disclaimerLink:"Lees de disclaimer.",selectLanguage:"Kies een taal",accept:"Accepteren en doorgaan",translationInProgress:"De tekst wordt vertaald. Even geduld graag...",translationFailed:"Vertaling mislukt.",failedETranslation:"eTranslation is momenteel niet beschikbaar. Probeer het later opnieuw.",failedWebtools:"Sorry, deze pagina kan om technische redenen niet worden vertaald.",retry:"Probeer het nog eens",readDisclaimer:"Disclaimer lezen",returnToLanguage:"Weergeven in de oorspronkelijke taal ({original_language})",translationAborted:"De inhoud van de pagina is gewijzigd. Gelieve {link}de vertaling opnieuw te beginnen{/link}.",labelCancelTranslation:"Vertaling annuleren"},pl:{automaticallyTranslated:"Strona przetłumaczona automatycznie",machineTranslation:"Strona została przetłumaczona maszynowo.<br />Pomóż nam usprawnić usługę, {link}odpowiadając na dwa pytania{/link}.",translatePage:"Przetłumacz tę stronę",translate:"Przetłumacz",close:"Zamknij",closeAriaLabel:"Aby zamknąć okno, naciśnij Esc.",closeTitle:"Zamknij okno",attention:"Zastrzeżenie prawne",disclaimer:"Strona została przetłumaczona maszynowo przez serwis eTranslation Komisji Europejskiej w celu ułatwienia użytkownikowi zrozumienia treści tekstu w języku obcym.",disclaimerLink:"Proszę zapoznać się z warunkami korzystania z serwisu.",selectLanguage:"Wybierz język",accept:"Zaakceptuj i kontynuuj",translationInProgress:"Trwa generowanie tłumaczenia. Proszę czekać.",translationFailed:"Nie udało się wygenerować tłumaczenia.",failedETranslation:"Serwis eTranslation jest obecnie niedostępny. Spróbuj ponownie później.",failedWebtools:"Niestety ze względu na problemy techniczne strona ta nie może zostać przetłumaczona.",retry:"Spróbuj ponownie",readDisclaimer:"przeczytaj zastrzeżenie prawne",returnToLanguage:"Wróć do wersji oryginalnej ({original_language})",translationAborted:"Treść strony zmieniła się. {link}Przetłumacz ponownie{/link}.",labelCancelTranslation:"Anuluj"},pt:{automaticallyTranslated:"Página traduzida por tradução automática",machineTranslation:"Esta página foi traduzida através de tradução automática.<br />Ajude-nos a melhorar o nosso serviço {link}respondendo a duas questões{/link}.",translatePage:"Traduzir esta página",translate:"Traduzir",close:"Fechar",closeAriaLabel:"Carregue em ESC para fechar esta janela",closeTitle:"Fechar esta janela",attention:"Aviso legal",disclaimer:"Esta é uma tradução automática disponibilizada pelo serviço eTranslation da Comissão Europeia para o/a ajudar a compreender o conteúdo desta página.",disclaimerLink:"Leia, por favor, as condições de utilização.",selectLanguage:"Selecionar língua abaixo",accept:"Aceitar e continuar",translationInProgress:"Tradução em curso. Por favor aguarde.",translationFailed:"A tradução falhou.",failedETranslation:"O serviço eTranslation não está disponível neste momento. Volte a tentar mais tarde.",failedWebtools:"Lamentamos, mas esta página não pode ser traduzida devido a questões técnicas.",retry:"Volta a tentar",readDisclaimer:"Leia a declaração de exoneração de responsabilidade",returnToLanguage:"Voltar à língua original ({original_language})",translationAborted:"O conteúdo da página mudou. Queira {link}reiniciar a tradução{/link}.",labelCancelTranslation:"Cancelar tradução"},ro:{automaticallyTranslated:"Pagină tradusă automat",machineTranslation:"Această pagină a fost tradusă prin traducere automată.<br />Ajutați-ne să ne îmbunătățim serviciul {link}răspunzând la 2 întrebări{/link}.",translatePage:"Tradu această pagină",translate:"Tradu",close:"Închide",closeAriaLabel:"Apăsați tasta ESC pentru a închide această fereastră",closeTitle:"Închideți această fereastră",attention:"Declinarea responsabilității",disclaimer:"Se va efectua o traducere automată furnizată de serviciul eTranslation al Comisiei Europene. Scopul este de a vă ajuta să înțelegeți în linii mari această pagină.",disclaimerLink:"Vă rugăm să citiți condițiile de utilizare.",selectLanguage:"Selectați mai jos limba",accept:"Acceptați și continuați",translationInProgress:"Traducere în curs, vă rugăm să așteptați.",translationFailed:"Traducerea nu a putut fi efectuată.",failedETranslation:"Serviciul eTranslation este momentan indisponibil. Vă rugăm să încercați mai târziu.",failedWebtools:"Ne pare rău, această pagină nu poate fi tradusă pentru că prezintă probleme tehnice.",retry:"Încercați din nou",readDisclaimer:"Citiți declinarea responsabilității",returnToLanguage:"Înapoi la limba originală ({original_language})",translationAborted:"Conținutul paginii s-a modificat. Vă rugăm {link}să relansați traducerea{/link}.",labelCancelTranslation:"Anulați traducerea"},sk:{automaticallyTranslated:"Automaticky preložená stránka",machineTranslation:"Táto strana bola preložená pomocou strojového prekladu.<br />Pomôžte nám vylepšiť túto službu tým, {link}že odpoviete na dve otázky{/link}.",translatePage:"Preložiť túto stránku",translate:"Preložiť",close:"Zavrieť",closeAriaLabel:"Keď chcete toto okno zavrieť, stlačte ESC",closeTitle:"Zavrieť toto okno",attention:"Vyhlásenie o odmietnutí zodpovednosti",disclaimer:"Toto je strojový preklad, ktorý vám poskytla služba eTranslation Európskej komisie na pochopenie tejto stránky.",disclaimerLink:"Prečítajte si podmienky používania.",selectLanguage:"Vybrať jazyk",accept:"Potvrdiť a pokračovať",translationInProgress:"Preklad sa pripravuje Prosíme chvíľu počkať.",translationFailed:"Stránku sa nepodarilo preložiť.",failedETranslation:"Služba eTranslation je momentálne nedostupná. Skúste to znova neskôr.",failedWebtools:"Ľutujeme, ale z technických dôvodov nie je možné túto stránku preložiť.",retry:"Skúsiť znova",readDisclaimer:"Prečítajte si vyhlásenie o odmietnutí zodpovednosti",returnToLanguage:"Späť na pôvodný jazyk ({original_language})",translationAborted:"Obsah stránky sa zmenil. Prosím {link}reštartujte preklad{/link}.",labelCancelTranslation:"Zrušiť preklad"},sl:{automaticallyTranslated:"Samodejno prevedena stran",machineTranslation:"Ta stran je bila strojno prevedena.<br />Pomagajte nam izboljšati storitev, {link}tako da odgovorite na dve vprašanji{/link}.",translatePage:"Prevedi to stran",translate:"Prevedi",close:"Zapri",closeAriaLabel:"Pritisnite esc, da zaprete okno",closeTitle:"Zapri okno",attention:"Izjava o omejitvi odgovornosti",disclaimer:"To je strojni prevod prek storitve eTranslation Evropske komisije v pomoč pri razumevanju te strani.",disclaimerLink:"Preberite pogoje uporabe.",selectLanguage:"Izberite jezik",accept:"Sprejmi in nadaljuj",translationInProgress:"Stran se prevaja. Počakajte trenutek.",translationFailed:"Prevajanje ni uspelo.",failedETranslation:"eTranslation trenutno ni na voljo. Poskusite ponovno pozneje.",failedWebtools:"Te strani zaradi tehničnih težav ni mogoče prevesti.",retry:"Poskusite znova",readDisclaimer:"Izjava o omejitvi odgovornosti",returnToLanguage:"Nazaj na izvirnik ({original_language})",translationAborted:"Vsebina strani se je spremenila. Znova {link}zaženite prevod{/link}.",labelCancelTranslation:"Prekliči prevod"},sv:{automaticallyTranslated:"Maskinöversatt sida",machineTranslation:"Sidan är maskinöversatt.<br />Hjälp oss att förbättra verktyget genom att {link}svara på två frågor{/link}.",translatePage:"Översätt den här sidan",translate:"Översätt",close:"Stäng",closeAriaLabel:"Tryck på Esc-knappen för att stänga fönstret",closeTitle:"Stäng fönstret",attention:"Ansvarsfriskrivning",disclaimer:"Sidan maskinöversätts av EU-kommissionens verktyg eTranslation för att hjälpa dig att förstå innehållet.",disclaimerLink:"Läs användarvillkoren",selectLanguage:"Välj språk",accept:"Godkänn och fortsätt",translationInProgress:"Texten översätts. Vänligen vänta.",translationFailed:"Översättningen misslyckades.",failedETranslation:"eTranslation är inte tillgängligt just nu. Försök igen senare.",failedWebtools:"Vi beklagar, men den här sidan kan inte översättas av tekniska skäl.",retry:"Försök igen",readDisclaimer:"Läs ansvarsfriskrivningen",returnToLanguage:"Gå tillbaka till originalspråket ({original_language})",translationAborted:"Sidans innehåll har ändrats. {link}Översätt sidan på nytt{/link}",labelCancelTranslation:"Avbryt översättningen"},uk:{automaticallyTranslated:"Сторінку перекладено автоматично",machineTranslation:"Цю сторінку перекладено за допомогою машинного перекладу.<br />Допоможіть нам удосконалити послугу, {link}відповівши на два запитання{/link}",translatePage:"Перекласти цю сторінку",translate:"Перекласти",close:"Закрити",closeAriaLabel:"Щоб закрити вікно, натисніть ESC",closeTitle:"Закрити це вікно",attention:"Застереження",disclaimer:"Це машинний переклад, виконаний службою електронного перекладу Європейської комісії, щоб допомогти Вам зрозуміти цю сторінку.",disclaimerLink:"Будь ласка, прочитайте умови використання.",selectLanguage:"Виберіть мову нижче",accept:"Погодитись і продовжити",translationInProgress:"Переклад виконується. Будь ласка, зачекайте.",translationFailed:"Переклад не виконано.",failedETranslation:"Зараз немає доступу до eTranslation. Будь ласка, спробуйте згодом.",failedWebtools:"Вибачте, з технічних причин цю сторінку неможливо перекласти.",retry:"Спробуйте знову",readDisclaimer:"читати застереження",returnToLanguage:"Повернутися до мови оригіналу ({original_language})",translationAborted:"Контент сторінки було змінено. Будь ласка, {link}розпочніть переклад знову{/link}.",labelCancelTranslation:"Скасувати переклад"},ru:{automaticallyTranslated:"Страница переведена автоматически",machineTranslation:"Эта страница переведена при помощи машинного перевода.<br />Помогите нам усовершенствовать услугу, {link}ответив на два вопроса{/link}",translatePage:"Перевести эту страницу",translate:"Перевести",close:"Закрыть",closeAriaLabel:"Чтобы закрыть окно, нажмите ESC",closeTitle:"Закрыть это окно",attention:"Оговорка",disclaimer:"Это машинный перевод, выполненный службой электронного перевода Европейской комиссии, чтобы помочь Вам понять эту страницу.",disclaimerLink:"Пожалуйста, прочтите условия пользования.",selectLanguage:"Выберите язык ниже",accept:"Принять и продолжить",translationInProgress:"Перевод выполняется. Пожалуйста, подождите.",translationFailed:"Перевод не выполнен.",failedETranslation:"Сейчас нет доступа к eTranslation. Пожалуйста, попытайтесь позже.",failedWebtools:"Извините, по техническим причинам эту страницу невозможно перевести.",retry:"Попытайтесь снова",readDisclaimer:"читать оговорку",returnToLanguage:"Вернуться к языку оригинала ({original_language})",translationAborted:"Контент страницы был изменен. Пожалуйста, {link}начните перевод снова{/link}.",labelCancelTranslation:"Отменить перевод"},zh:{automaticallyTranslated:"自动翻译页面",machineTranslation:"本页面是机器翻译。<br/>请通过{link}回答两个问题{/link}，帮助我们改善服务",translatePage:"翻译本页",translate:"翻译",close:"关闭",closeAriaLabel:"请按ESC(退出键)关闭本窗口",closeTitle:"关闭本窗口",attention:"免责声明",disclaimer:"这是欧盟委员会机器翻译服务eTranslation提供的机器翻译，旨在帮助您了解本页内容。",disclaimerLink:"请阅读使用条件。",selectLanguage:"请选择以下语言",accept:"接受并继续",translationInProgress:"翻译进行中。请稍等。",translationFailed:"翻译失败。",failedETranslation:"目前并无eTranslation的机器翻译。请稍后再试。",failedWebtools:"对不起，由于技术问题，本页面无法翻译。",retry:"请再试一次",readDisclaimer:"请阅读免责声明",returnToLanguage:"回到原始语言({original_language})",translationAborted:"页面内容发生了变化。請{link}重新翻譯{/link}。",labelCancelTranslation:"取消翻译"},ja:{automaticallyTranslated:"自動翻訳されたページ",machineTranslation:"このページは機械翻訳を使用して翻訳されました。<br />{link}2つの質問に回答して{/link}、サービスの向上にご協力ください。",translatePage:"このページを翻訳する",translate:"翻訳する",close:"閉じる",closeAriaLabel:"このウィンドウを閉じるにはESCキーを押してください",closeTitle:"ウィンドウを閉じる",attention:"免責事項",disclaimer:"これは、このページを理解するのに役立つ、欧州委員会のeTranslationサービスによって提供される機械翻訳です。",disclaimerLink:"ご利用条件を必ずお読みください。",selectLanguage:"以下で言語を選択",accept:"承諾して続行",translationInProgress:"翻訳は進行中です。お待ちください。",translationFailed:"翻訳は失敗しました。",failedETranslation:"現在、eTranslationはご利用いただけません。後でもう一度お試しください。",failedWebtools:"申し訳ありませんが、このページは技術的な問題により翻訳できません。",retry:"もう一度試す",readDisclaimer:"免責事項を読む",returnToLanguage:"元の言語（{original_language}）に戻る",translationAborted:"ページの内容が変わりました。{link}翻訳を再開してください{/link}。",labelCancelTranslation:"翻訳をキャンセル"},tr:{automaticallyTranslated:"Otomatik olarak tercüme edilmiş sayfa",machineTranslation:"Bu sayfa makine tercümesi kullanılarak çevrilmiştir.<br />{link}İki soruyu yanıtlayarak{/link} hizmetimizi geliştirmemize yardımcı olun",translatePage:"Bu sayfayı tercüme et",translate:"Tercüme et",close:"Kapat",closeAriaLabel:"Bu pencereyi kapatmak için ESC tuşuna basın",closeTitle:"Bu pencereyi kapat",attention:"Sorumluluğun Reddi Beyanı",disclaimer:"Bu, bu sayfayı anlamanıza yardımcı olmak için Avrupa Komisyonu’nun eTranslation hizmeti tarafından sağlanan bir makine çevirisidir.",disclaimerLink:"Lütfen kullanım koşullarını okuyunuz.",selectLanguage:"Aşağıdan dil seçin",accept:"Kabul et ve devam et",translationInProgress:"Tercüme işlemi devam etmektedir. Lütfen bekleyin.",translationFailed:"Tercüme işlemi başarısız oldu.",failedETranslation:"eTranslation şu anda kullanılamıyor. Lütfen daha sonra tekrar deneyin.",failedWebtools:"Üzgünüz, teknik sorunlar nedeniyle bu sayfa tercüme edilemiyor.",retry:"Yeniden deneyin",readDisclaimer:"Sorumluluk reddi beyanını okuyun",returnToLanguage:"Özgün dile geri dön ({original_language})",translationAborted:"Sayfanın içeriği değişti. Lütfen {link}tercüme işlemini yeniden başlatın{/link}.",labelCancelTranslation:"Tercüme işlemini iptal et"},no:{automaticallyTranslated:"Automatisk oversatt side",machineTranslation:"Denne si